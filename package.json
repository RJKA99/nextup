{
  "name": "todo-scheduler",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": ["client", "server", "mcp-server"],
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "dotenv -e .env.local -- npm run dev -w server",
    "dev:client": "npm run dev -w client",
    "build": "npm run build -w client",
    "build:server": "npm run build -w server"
  },
  "devDependencies": {
    "@vercel/config": "^0.5.5",
    "concurrently": "^8.2.2",
    "dotenv-cli": "^7.4.2"
  }
}
